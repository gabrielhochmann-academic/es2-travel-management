@startuml
left to right direction
skinparam backgroundColor #F3F0E9
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #0E4D5A
  ArrowColor #0E4D5A
}
skinparam actor {
  BorderColor #0E4D5A
  BackgroundColor #F8C297
}

actor "Colaborador" as Colaborador
actor "Gestor" as Gestor

rectangle "Sistema de Gestão de Viagens" {
  usecase "Registrar viagem" as UC1
  usecase "Consultar / alterar /\nexcluir viagem" as UC2
  usecase "Submeter viagem\npara análise" as UC3
  usecase "Aprovar ou rejeitar\nviagem" as UC4
  usecase "Consultar histórico\nde situação" as UC5
  usecase "Registrar despesas" as UC6
  usecase "Consultar despesas e\nresumo financeiro" as UC7
  usecase "Pesquisar viagens" as UC8
  usecase "Visualizar indicadores\ngerenciais" as UC9
}

Colaborador --> UC1
Colaborador --> UC2
Colaborador --> UC3
Colaborador --> UC5
Colaborador --> UC6
Colaborador --> UC7
Colaborador --> UC8
Gestor --> UC4
Gestor --> UC5
Gestor --> UC8
Gestor --> UC9
UC6 .> UC4 : <<requer viagem aprovada>>
UC4 .> UC5 : <<registra alteração>>
@enduml
